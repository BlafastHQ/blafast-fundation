includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    ignoreErrors:
        # config/ here IS this package's config directory — larastan's env-outside-
        # of-config rule only recognizes the host app's config path, so every
        # env() default in these files is a false positive.
        -
            identifier: larastan.noEnvCallsOutsideOfConfig
            path: config/*
    paths:
        - src
        - config
        - database
    tmpDir: build/phpstan
    checkOctaneCompatibility: true
    checkModelProperties: true
    scanFiles:
        - stubs/User.stub
